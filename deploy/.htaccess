DirectoryIndex index.php

# Захист: прямий доступ до app.html заборонено, доступ лише через авторизований index.php
<Files "app.html">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
